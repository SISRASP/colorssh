def load_presets(path):
    presets = builtin_presets()
    if not path.exists():
        write_presets(path, presets)
        return presets
    value = json.loads(path.read_text(encoding='utf-8'))
    if not isinstance(value, dict) or any(
            not isinstance(name, str) or not name.strip() or len(name) > 60 or
            not name.isprintable() or not valid_colors(colors)
            for name, colors in value.items()):
        raise ValueError('Archivo de combinaciones inválido')
    presets.update({name: colors + copy.deepcopy(DEFAULT[len(colors):])
                    for name, colors in value.items()})
    if presets != value:
        write_presets(path, presets)
    return presets


def save_preset(path, name, colors):
    name = name.strip()
    if not name or len(name) > 60 or not name.isprintable():
        raise ValueError('Usa un nombre de 1 a 60 caracteres visibles')
    if not valid_colors(colors):
        raise ValueError('Colores inválidos')
    presets = load_presets(path)
    presets[name] = copy.deepcopy(colors)
    write_presets(path, presets)


def write_presets(path, presets):
    if path.parent == config_dir():
        secure_directory(path.parent)
    else:
        path.parent.mkdir(parents=True, exist_ok=True)
    tmp = None
    try:
        with tempfile.NamedTemporaryFile(mode='w', encoding='utf-8', dir=path.parent,
                                         prefix='.colorssh-presets-', delete=False) as stream:
            tmp = Path(stream.name)
            json.dump(presets, stream, ensure_ascii=False, indent=2)
            stream.write('\n')
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(tmp, path)
        os.chmod(path, 0o600)
    finally:
        if tmp is not None and tmp.exists():
            tmp.unlink()



class App:
    def __init__(self, path, presets_path=None):
        self.presets_path = presets_path or config_dir()/'presets.json'
        self.mode = None
        self.name = ''
        self.presets = {}
        self.preset_index = 0
        self.path = path
        self.original = path.read_bytes()
        self.colors = load_colors(self.original.decode('utf-8'))
        migrate_backups(path)
        self.presets = load_presets(self.presets_path)
        self.saved = copy.deepcopy(self.colors)
        self.target = self.channel = 0
        self.color_mode = 'RGB'
        self.hsv_cache = {}
        self.message = 'Selecciona un color. M: alternar RGB / tono, saturación y brillo.'
        self.pending_exit = False
        self.width = 32
        self.hits = []

    def controls(self):
        if self.color_mode == 'RGB':
            return ('Rojo', 'Verde', 'Azul'), self.colors[self.target].copy(), (255, 255, 255)
        rgb = tuple(self.colors[self.target])
        cached_rgb, values = self.hsv_cache.get(self.target, (None, None))
        if cached_rgb != rgb:
            h, s, v = colorsys.rgb_to_hsv(*(c/255 for c in rgb))
            values = [h*360, s*100, v*100]
            self.hsv_cache[self.target] = (rgb, values)
        return ('Tono', 'Satur', 'Brillo'), values.copy(), (360, 100, 100)

    def control_rgb(self, values):
        if self.color_mode == 'RGB':
            return values.copy()
        return [round(c*255) for c in colorsys.hsv_to_rgb(values[0]/360, values[1]/100, values[2]/100)]

    def set_channel(self, value):
        _, values, limits = self.controls()
        values[self.channel] = max(0, min(limits[self.channel], value))
        self.colors[self.target] = self.control_rgb(values)
        if self.color_mode == 'HSV':
            # Conserva tono y saturación incluso al pasar por negro o gris.
            self.hsv_cache[self.target] = (tuple(self.colors[self.target]), values)

    def layout(self):
        cols, rows = shutil.get_terminal_size()
        left = min(48, max(35, cols * 44 // 100))
        return cols, rows, left, left + 3, cols - left - 3

    def draw(self):
        cols, rows, left, right, panel = self.layout()
        reset = ESC + '0m'
        muted = ESC + '38;5;245m'
        accent = ESC + '38;5;81m'
        tracking = ESC+'?1003h' if self.mode == 'load' else ESC+'?1003l'+ESC+'?1002h'
        out = [tracking + ESC + 'H' + reset + ESC + '2J']
        self.hits = []

        def put(x, y, text, width=None, fill=''):
            width = cols - x if width is None else width
            text = fit_text(text, width)
            visible = text_width(text)
            out.append(f'{ESC}{y};{x}H' + fill + text + fill + ' ' * (width-visible) + reset)

        def box(x, y, width, height, title):
            put(x, y, accent + '┌' + ('─ ' + title + ' ').ljust(width-2, '─') + '┐', width)
            for row in range(y+1, y+height-1):
                put(x, row, muted + '│', 1)
                put(x+width-1, row, muted + '│', 1)
            put(x, y+height-1, muted + '└' + '─'*(width-2) + '┘', width)

        if cols < 80 or rows < 32:
            put(2, 1, 'COLORSSH · Amplía la terminal a 80 × 32. Q: salir')
            sys.stdout.write(''.join(out)); sys.stdout.flush()
            return
        put(2, 1, ESC + '1mCOLORSSH' + reset + '  /  Colores de Bash')
        put(2, 2, muted + 'Selecciona un elemento · Ajusta el color · Comprueba el resultado · Guarda')
        box(2, 3, left, 24, 'COMBINACIONES' if self.mode == 'load' else 'PALETA · 20 COLORES')
        if self.mode == 'load':
            names = list(self.presets)
            start = self.preset_index // 20 * 20
            for row, name in enumerate(names[start:start+20], 5):
                selected = names.index(name) == self.preset_index
                swatches = ''.join(sgr(c, True) + ' ' for c in self.presets[name][:8]) + reset
                put(4, row, ('▶ ' if selected else '  ') + fit_text(name, left-15).ljust(left-15) + ' ' + swatches, left-4)
                self.hits.append((4, row, left-4, ('preset', start+row-5)))
            put(4, 25, f'{self.preset_index+1}/{len(names)}  ↑↓ elegir · Enter cargar', left-4)
        else:
            put(4, 4, muted + 'Elemento / muestra / HEX', left-4)
            for i, name in enumerate(LABELS):
                selected = i == self.target
                label = fit_text(name, left-17).ljust(left-17)
                text = (accent + '▶ ' if selected else '  ') + label + reset
                text += ' ' + sgr(self.colors[i], True) + '  ' + reset + ' ' + hexcolor(self.colors[i])
                put(4, 5+i, text, left-4)
                self.hits.append((4, 5+i, left-4, ('target', i)))
            put(4, 25, muted + '↑↓ / rueda: elegir · clic: seleccionar', left-4)

        box(right, 3, panel, 8, 'EDITAR COLOR · ' + self.color_mode)
        put(right+2, 4, ESC+'1m'+LABELS[self.target], panel-4)
        self.width = panel-20
        names, values, limits = self.controls()
        for i, name in enumerate(names):
            value = values[i]
            pos = round(value*(self.width-1)/limits[i])
            bar = ''
            for x in range(self.width):
                sample = values.copy()
                sample[i] = round(x*limits[i]/(self.width-1))
                if self.color_mode == 'HSV' and i == 0:
                    sample[1:] = [100, 100]
                color = self.control_rgb(sample)
                ink = [0, 0, 0] if sum(color) > 382 else [255, 255, 255]
                bar += sgr(color, True) + sgr(ink) + ('┃' if x == pos else ' ')
            unit = ('°' if i == 0 else '%') if self.color_mode == 'HSV' else ''
            put(right+2, 5+i, ('▶ ' if i == self.channel else '  ') + name.ljust(5) + ' ' + bar + reset + f' {round(value):3d}' + unit, panel-4)
            self.hits.append((right+10, 5+i, self.width, ('channel', i)))
        color = self.colors[self.target]
        put(right+2, 8, f'{hexcolor(color)}  RGB({color[0]}, {color[1]}, {color[2]})', panel-4)
        put(right+2, 9, muted + 'M: RGB / HSV · Tab: cambiar canal', panel-4)

        box(right, 11, panel, 16, 'VISTA PREVIA · EN DIRECTO')
        preview_name = list(self.presets)[self.preset_index] if self.mode == 'load' else None
        preview_colors = self.presets[preview_name] if preview_name is not None else self.colors
        base = sgr(preview_colors[0], True) + sgr(preview_colors[1])
        prompt = sgr(preview_colors[3], True) + sgr(preview_colors[2]) + ESC+'1musuario@host:~$'+ESC+'22m'+base
        for y in range(12, 26):
            put(right+1, y, '', panel-2, base)
        put(right+2, 12, prompt + ' ls -F --color=auto', panel-4, base)
        cell = (panel-4)//2
        for i, (_, _, _, sample) in enumerate(FILE_TYPES):
            put(right+2+(i%2)*cell, 14+i//2, sgr(preview_colors[i+4]) + sample, cell, base)
        put(right+2, 23, prompt + ' echo "Hola"', panel-4, base)
        put(right+2, 24, 'Hola · Texto normal de la terminal', panel-4, base)
        if preview_name is not None:
            put(right+2, 25, 'Probar: ' + preview_name, panel-4, base)

        put(2, 27, muted + 'Bash file: ' + display_text(self.path))
        x = 2
        actions = [('s', 'S Aplicar a Bash'), ('r', 'R Restaurar'), ('n', 'N Guardar combinación'), ('c', 'C Combinaciones'), ('q', 'Q Salir')]
        if cols < 100:
            actions = [('s', 'S Bash'), ('r', 'R Restaurar'), ('n', 'N Comb.'), ('c', 'C Cargar'), ('q', 'Q Salir')]
        for key, label in actions:
            text = '[ ' + label + ' ]'
            put(x, 28, accent + text, len(text))
            self.hits.append((x, 28, len(text), ('action', key)))
            x += len(text)+1
        put(2, 29, muted + 'M: RGB/HSV · ↑↓: elemento · ←→: ±1 · +/-: ±10 · Inicio/Fin: mín/máx')
        changes = sum(a != b for a, b in zip(self.colors, self.saved))
        put(2, 30, f'● {changes} colores modificados · S para aplicar a Bash' if changes else '✓ Sin cambios pendientes')
        put(2, 31, self.message)
        if self.mode == 'name':
            put(2, 27, 'Guardar combinación · Nombre: ' + self.name + '_')
            put(2, 28, 'Escribe un nombre y pulsa Enter · Esc: cancelar')
        elif self.mode == 'load':
            put(2, 28, 'Ratón / ↑↓: vista previa · Enter: cargar · Esc: cancelar')
        sys.stdout.write(''.join(out)); sys.stdout.flush()

    def act(self, key):
        if self.mode:
            if key in ('\x1b', '\x03'):
                self.mode = None
            elif self.mode == 'name':
                if key in ('\r', '\n'):
                    try:
                        save_preset(self.presets_path, self.name, self.colors)
                        self.message = 'Combinación guardada: ' + self.name.strip()
                        self.mode = None
                    except (OSError, ValueError) as error:
                        self.message = display_text(error)
                elif key in ('\x7f', '\b'):
                    self.name = self.name[:-1]
                elif len(key) == 1 and key.isprintable() and len(self.name) < 60:
                    self.name += key
            elif self.mode == 'load':
                mouse = re.fullmatch(r'\x1b\[<(\d+);(\d+);(\d+)([Mm])', key)
                if mouse and mouse[4] == 'M':
                    button, x, y = map(int, mouse.group(1, 2, 3))
                    if button in (64, 65):
                        self.preset_index = (self.preset_index + (1 if button == 65 else -1)) % len(self.presets)
                    elif button in (0, 32, 35):
                        for hx, hy, width, (kind, index) in self.hits:
                            if kind == 'preset' and y == hy and hx <= x < hx+width:
                                self.preset_index = index
                                break
                if key in ('\x1b[A', '\x1b[B'):
                    self.preset_index = (self.preset_index + (1 if key.endswith('B') else -1)) % len(self.presets)
                elif key in ('\r', '\n'):
                    name = list(self.presets)[self.preset_index]
                    self.colors = copy.deepcopy(self.presets[name])
                    self.hsv_cache.clear()
                    self.message = 'Cargada: ' + name + '. S: aplicar a Bash.'
                    self.mode = None
            return True
        if key in ('q', 'Q', '\x03', '\x1b'):
            if self.colors != self.saved and not self.pending_exit:
                self.message = 'Hay cambios sin guardar. Q otra vez: descartar; S: guardar.'
                self.pending_exit = True
                return True
            return False
        self.pending_exit = False
        if key.lower() == 'm':
            self.color_mode = 'HSV' if self.color_mode == 'RGB' else 'RGB'
            self.message = ('HSV: tono = color · saturación = intensidad · brillo = luminosidad.'
                            if self.color_mode == 'HSV' else 'RGB: rojo, verde y azul. M: volver a tono, saturación y brillo.')
        elif key.lower() in ('n', 'g'):
            self.mode = 'name'
            self.name = ''
        elif key.lower() == 'c':
            try:
                self.presets = load_presets(self.presets_path)
                self.preset_index = 0
                if self.presets:
                    self.mode = 'load'
                else:
                    self.message = 'No hay combinaciones. N: guardar una con nombre.'
            except (OSError, ValueError) as error:
                self.message = display_text(error)
        elif key.lower() == 's':
            try:
                self.original, backup = save_colors(self.path, self.original, self.colors)
                self.saved = copy.deepcopy(self.colors)
                self.message = 'Guardado. Copia: ' + backup.name
            except (OSError, ValueError) as error:
                self.message = display_text(error)
        elif key.lower() == 'r':
            self.colors = copy.deepcopy(self.saved)
            self.hsv_cache.clear()
            self.message = 'Restaurados los últimos colores guardados.'
        elif key in ('\t', '\x1b[B', '\x1b[A'):
            if key == '\t': self.channel = (self.channel+1) % 3
            else: self.target = (self.target + (1 if key.endswith('B') else -1)) % len(LABELS)
        elif key in ('\x1b[C', '\x1b[D', '+', '-', '\x1b[H', '\x1b[F', '\x1b[1~', '\x1b[4~'):
            _, values, limits = self.controls()
            current = round(values[self.channel])
            if key in ('\x1b[H', '\x1b[1~'): value = 0
            elif key in ('\x1b[F', '\x1b[4~'): value = limits[self.channel]
            else: value = current + {'\x1b[C':1, '\x1b[D':-1, '+':10, '-':-10}[key]
            self.set_channel(value)
        else:
            mouse = re.fullmatch(r'\x1b\[<(\d+);(\d+);(\d+)([Mm])', key)
            if mouse:
                button, x, y = map(int, mouse.group(1,2,3))
                if mouse[4] == 'M' and button in (64, 65):
                    self.target = (self.target + (1 if button == 65 else -1)) % len(LABELS)
                if mouse[4] == 'M' and button in (0,32):
                    for hx, hy, width, (kind, value) in self.hits:
                        if y != hy or not hx <= x < hx+width:
                            continue
                        if kind == 'target' and button == 0:
                            self.target = value
                        elif kind == 'channel':
                            self.channel = value
                            self.set_channel(round((x-hx)*self.controls()[2][value]/(width-1)))
                        elif kind == 'action' and button == 0:
                            return self.act(value)
                        break
        return True

    def run(self):
        fd = sys.stdin.fileno()
        old = termios.tcgetattr(fd)
        old_term = signal.getsignal(signal.SIGTERM)
        def terminate(*_): raise KeyboardInterrupt
        signal.signal(signal.SIGTERM, terminate)
        buffer = ''
        decoder = codecs.getincrementaldecoder('utf-8')(errors='replace')
        try:
            tty.setraw(fd)
            sys.stdout.write(ESC+'?1049h'+ESC+'?25l'+ESC+'?1002h'+ESC+'?1006h')
            active = True
            while active:
                self.draw()
                if not select.select([fd], [], [], .15)[0]: continue
                chunk = os.read(fd, 4096)
                if not chunk: break
                buffer += decoder.decode(chunk)
                while buffer:
                    if buffer.startswith('\x1b'):
                        match = re.match(r'\x1b\[(?:<\d+;\d+;\d+[Mm]|[0-9;]*[A-Za-z~])', buffer)
                        if match: key = match[0]
                        elif buffer == '\x1b':
                            if select.select([fd], [], [], .04)[0]: break
                            key = buffer
                        elif len(buffer) < 64 and (buffer.startswith('\x1b[<') or not re.search('[A-Za-z~]', buffer[2:])): break
                        else: key = buffer[:2]
                    else: key = buffer[0]
                    buffer = buffer[len(key):]
                    active = self.act(key)
                    if not active: break
        finally:
            sys.stdout.write(ESC+'0m'+ESC+'?1003l'+ESC+'?1002l'+ESC+'?1006l'+ESC+'?25h'+ESC+'?1049l')
            sys.stdout.flush()
            termios.tcsetattr(fd, termios.TCSADRAIN, old)
            signal.signal(signal.SIGTERM, old_term)
        print('Para aplicar lo guardado en este shell: source ' + __import__('shlex').quote(str(self.path)))


def main():
    parser = argparse.ArgumentParser(description='Configura colores RGB de Bash con ratón o flechas y copia de seguridad automática.')
    parser.add_argument('--bashrc', type=Path, default=Path.home()/'.bashrc', help='archivo Bash que editar (por defecto ~/.bashrc)')
    parser.add_argument('--presets', type=Path, help='archivo JSON de combinaciones (por defecto ~/.config/colorssh/presets.json)')
    args = parser.parse_args()
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        parser.exit(1, 'Ejecuta colorssh en una terminal interactiva.\n')
    if os.geteuid() == 0:
        parser.exit(1, 'No ejecutes colorssh como root.\n')
    try:
        App(args.bashrc.expanduser().resolve(), args.presets.expanduser().resolve() if args.presets else None).run()
    except KeyboardInterrupt:
        pass
    except (OSError, ValueError) as error:
        parser.exit(1, f'Error: {error}\n')


if __name__ == '__main__':
    main()
