FILE_TYPES = [
    ('fi', 'Archivo normal', [229, 229, 229], 'archivo.txt'),
    ('di', 'Directorio', [92, 92, 255], 'carpeta/'),
    ('ex', 'Ejecutable', [0, 205, 0], 'script.sh*'),
