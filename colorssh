ESC = '\x1b['


ANSI = re.compile(r'\x1b\[[0-9;]*m')


def text_width(text):
    return sum(0 if unicodedata.combining(c) else 2 if unicodedata.east_asian_width(c) in 'WF' else 1
               for c in ANSI.sub('', text))


def fit_text(text, width):
    result = []
    used = 0
    for part in re.split(r'(\x1b\[[0-9;]*m)', text):
        if ANSI.fullmatch(part):
            result.append(part)
            continue
        for char in part:
            size = text_width(char)
            if used + size > width:
                return ''.join(result)
            result.append(char)
            used += size
    return ''.join(result)


def config_dir():
    return Path.home()/'.config'/'colorssh'


def secure_directory(path):
    path.mkdir(parents=True, exist_ok=True)
    os.chmod(path, 0o700)


def display_text(value):
    """Return text that cannot introduce terminal control sequences."""
    return ''.join(char if char.isprintable() else '\ufffd' for char in str(value))


def migrate_backups(path):
    """Recoge las copias antiguas sin sobrescribir otras con el mismo nombre."""
    destination = config_dir()
    secure_directory(destination)
    for source in path.parent.glob(path.name + '.bak.colorssh.*'):
        if not source.is_file() or source.parent == destination:
            continue
        target = destination/source.name
        while target.exists():
            target = destination/(source.name + '.' + datetime.datetime.now().strftime('%Y%m%d-%H%M%S-%f'))
        with target.open('xb') as stream:
            os.chmod(target, 0o600)
            stream.write(source.read_bytes())
            stream.flush()
            os.fsync(stream.fileno())
        shutil.copystat(source, target)
        os.chmod(target, 0o600)
        source.unlink()


def valid_colors(value):
    return (isinstance(value, list) and len(value) in (4, len(DEFAULT)) and all(
        isinstance(c, list) and len(c) == 3 and all(type(v) is int and 0 <= v <= 255 for v in c)
        for c in value))


def hexcolor(rgb):
    return '#' + ''.join(f'{v:02x}' for v in rgb)


def sgr(rgb, background=False):
    return f'{ESC}{48 if background else 38};2;' + ';'.join(map(str, rgb)) + 'm'


def ansi_color(n):
    base = [(0,0,0),(205,0,0),(0,205,0),(205,205,0),(0,0,238),(205,0,205),(0,205,205),(229,229,229),
            (127,127,127),(255,0,0),(0,255,0),(255,255,0),(92,92,255),(255,0,255),(0,255,255),(255,255,255)]
    if n < 16:
        return list(base[n])
    if n < 232:
        n -= 16
        levels = [0,95,135,175,215,255]
        return [levels[n // 36], levels[n // 6 % 6], levels[n % 6]]
    return [8 + (n - 232) * 10] * 3


def load_colors(text):
    match = re.search(r'^# colorssh-colors: (.+)$', text, re.M)
    if match:
        value = json.loads(match[1])
        if not valid_colors(value):
            raise ValueError('Configuración colorssh inválida')
        return value + copy.deepcopy(DEFAULT[len(value):])
    colors = copy.deepcopy(DEFAULT)
    bg = re.search(r'11;#([0-9a-fA-F]{6})', text)
    if bg:
        colors[0] = [int(bg[1][i:i+2], 16) for i in (0,2,4)]
    prompt = re.search(r"^\s*PS1='([^'\n]*(?:\\033|\\e)\[[^'\n]*)'", text, re.M)
    if prompt:
        # La primera secuencia define los colores; el reset final no los cambia.
        match = re.search(r'\\(?:033|e)\[([\d;]+)m', prompt[1])
        if match:
            codes = list(map(int, match[1].split(';')))
            i = 0
            while i < len(codes):
                code = codes[i]
                if code in (38,48) and i + 2 < len(codes):
                    target = 2 if code == 38 else 3
                    if codes[i+1] == 5 and 0 <= codes[i+2] <= 255:
                        colors[target] = ansi_color(codes[i+2]); i += 3; continue
                    if codes[i+1] == 2 and i+4 < len(codes):
                        colors[target] = codes[i+2:i+5]; i += 5; continue
                if 30 <= code <= 37:
                    colors[2] = ansi_color(code - 30)
                if 40 <= code <= 47:
                    colors[3] = ansi_color(code - 40)
                i += 1
    return colors


def config_block(colors):
    colors = colors + copy.deepcopy(DEFAULT[len(colors):])
    file_colors = ':'.join(code + '=0;38;2;' + ';'.join(map(str, color))
                           for (code, *_), color in zip(FILE_TYPES, colors[4:]))
    fg, bg = (';'.join(map(str, colors[i])) for i in (2,3))
    return f'''{BEGIN}
# colorssh-colors: {json.dumps(colors)}
__colorssh_apply() {{
    case "$TERM" in
        xterm*|rxvt*|screen*|tmux*) printf '\\033]10;{hexcolor(colors[1])}\\007\\033]11;{hexcolor(colors[0])}\\007' ;;
    esac
}}
# Conserva los hooks originales, incluido el retorno de sesiones SSH.
if declare -F __set_terminal_background_black >/dev/null; then
    __set_terminal_background_black() {{ __colorssh_apply; }}
else
    if declare -p PROMPT_COMMAND 2>/dev/null | grep -q 'declare -a'; then
        if [[ ";${{PROMPT_COMMAND[*]}};" != *"__colorssh_apply"* ]]; then
            PROMPT_COMMAND+=(__colorssh_apply)
        fi
    elif [[ "${{PROMPT_COMMAND:-}}" != *"__colorssh_apply"* ]]; then
        PROMPT_COMMAND="__colorssh_apply${{PROMPT_COMMAND:+;$PROMPT_COMMAND}}"
    fi
fi
__colorssh_apply
# Las reglas por extensión existentes conservan su prioridad.
export LS_COLORS="${{LS_COLORS:+$LS_COLORS:}}{file_colors}"
alias ll='ls -alF --color=auto'
PS1='${{debian_chroot:+($debian_chroot)}}\\[\\033[1;38;2;{fg};48;2;{bg}m\\]\\u@\\h:\\w\\$\\[\\033[0m\\] '
{END}
'''


def save_colors(path, original, colors):
    """Valida, crea copia exclusiva y sustituye atómicamente sin pisar cambios externos."""
    if not valid_colors(colors):
        raise ValueError('Colores inválidos')
    path = path.expanduser().resolve(strict=True)
    if path.read_bytes() != original:
        raise ValueError('.bashrc ha cambiado externamente. Sal y vuelve a abrir la aplicación.')
    text = original.decode('utf-8')
    if text.count(BEGIN) != text.count(END) or text.count(BEGIN) > 1:
        raise ValueError('Bloque colorssh incompleto o duplicado; no se ha modificado el archivo.')
    block = config_block(colors)
    if BEGIN in text:
        pattern = re.compile(re.escape(BEGIN) + r'.*?' + re.escape(END) + r'\n?', re.S)
        if not pattern.search(text):
            raise ValueError('Marcadores colorssh desordenados')
        updated = pattern.sub(lambda _: block, text)
    else:
        updated = text + ('\n' if not text.endswith('\n') else '') + '\n' + block
    data = updated.encode('utf-8')
    result = subprocess.run(['bash', '-n'], input=data, capture_output=True)
    if result.returncode:
        raise ValueError('Bash rechaza la configuración: ' + result.stderr.decode().strip())
    secure_directory(config_dir())
    backup = config_dir()/(path.name + '.bak.colorssh.' + datetime.datetime.now().strftime('%Y%m%d-%H%M%S-%f'))
    with backup.open('xb') as stream:
        os.chmod(backup, 0o600)
        stream.write(original)
        stream.flush()
        os.fsync(stream.fileno())
    shutil.copystat(path, backup)
    os.chmod(backup, 0o600)
    tmp = None
    try:
        with tempfile.NamedTemporaryFile(dir=path.parent, prefix='.colorssh-', delete=False) as stream:
            tmp = Path(stream.name)
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
        shutil.copystat(path, tmp)
        if path.read_bytes() != original:
            raise ValueError('.bashrc ha cambiado durante el guardado; no se ha sobrescrito.')
        os.replace(tmp, path)
    finally:
        if tmp is not None and tmp.exists():
            tmp.unlink()
    return data, backup


